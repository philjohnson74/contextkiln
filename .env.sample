# Placeholders only. Copy to .env, which is gitignored.

# Agentic layer
# Anthropic API key for headless ADW runs on Claude
ANTHROPIC_API_KEY=
# Path to the Claude Code CLI, if `claude` isn't on your PATH
CLAUDE_CODE_PATH=claude
# Return Claude Code to the project root after every command
CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR=true

# Model profiles (used from Phase 3)
# Default profile: claude, claude-opus or local
ADW_PROFILE=claude
# Ollama tag used by the local profile
LOCAL_MODEL=qwen3-coder:30b
# Must match OLLAMA_CONTEXT_LENGTH. See ai_docs/local_models.md
CLAUDE_CODE_MAX_CONTEXT_TOKENS=65536

# Application LLM (used from Phase 4)
CK_LLM_PROVIDER=openai_compatible
CK_LLM_MODEL=qwen3:4b
CK_LLM_BASE_URL=http://localhost:11434/v1
